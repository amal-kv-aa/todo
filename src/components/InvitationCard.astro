---
import { wedding } from '../data/wedding';
import { weddingDate } from '../data/format';

const { groom, bride } = wedding.couple;

const cardData = {
  eyebrow: 'Together with their families, we invite you to the wedding of',
  groom: groom.fullName,
  bride: bride.fullName,
  groomParents: groom.parents,
  brideParents: bride.parents,
  weekday: weddingDate.weekday,
  monthLong: weddingDate.monthLong,
  day: weddingDate.day,
  year: weddingDate.year,
  time: weddingDate.time,
  venueName: wedding.venue.name,
  venueAddress: wedding.venue.address,
  message: wedding.invitationMessage,
  blessing: wedding.cardBlessing ?? '',
  fileName: `${groom.firstName}-and-${bride.firstName}-wedding-invitation`,
};
---

<article class="inv-card liquid-glass-gold reveal" aria-labelledby="card-heading">
  <h4 id="card-heading" class="ic-title">Wedding Invitation Card</h4>
  <p class="ic-sub">Download the official invitation card</p>

  <!-- Live preview card (also used as the download canvas source) -->
  <div class="ic-preview">
    <div class="ic-preview-frame">
      <div class="ic-preview-inner" data-invite-card>
        {cardData.blessing && <p class="ic-blessing">{cardData.blessing}</p>}
        <p class="ic-eyebrow">{cardData.eyebrow}</p>

        <h3 class="ic-name">{groom.fullName}</h3>
        <p class="ic-parents">{groom.parents}</p>

        <span class="ic-amp">&amp;</span>

        <h3 class="ic-name">{bride.fullName}</h3>
        <p class="ic-parents">{bride.parents}</p>

        <div class="ic-divider">
          <span class="hr"></span><span class="star">✦</span><span class="hr"></span>
        </div>

        <p class="ic-when">{weddingDate.weekday}, {weddingDate.monthLong} {weddingDate.day}, {weddingDate.year}</p>
        <p class="ic-time">{weddingDate.time}</p>

        <p class="ic-venue">{wedding.venue.name}</p>
        <p class="ic-venue-addr">{wedding.venue.address}</p>

        <p class="ic-msg">{cardData.message}</p>
      </div>
    </div>
  </div>

  <button class="btn-dark ic-btn" data-download-card type="button">
    <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 15V3"/><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><path d="m7 10 5 5 5-5"/>
    </svg>
    <span data-download-label>Download Card</span>
  </button>

  <script type="application/json" data-card-json set:html={JSON.stringify(cardData)} is:inline />
</article>

<script>
  import { downloadInvitationCard } from '../scripts/downloadCard';

  const btn = document.querySelector<HTMLButtonElement>('[data-download-card]');
  const jsonEl = document.querySelector<HTMLScriptElement>('[data-card-json]');
  const label = document.querySelector<HTMLElement>('[data-download-label]');

  if (btn && jsonEl) {
    const data = JSON.parse(jsonEl.textContent || '{}');
    btn.addEventListener('click', async () => {
      if (btn.dataset.busy) return;
      btn.dataset.busy = '1';
      const original = label?.textContent ?? '';
      if (label) label.textContent = 'Preparing…';
      try {
        await downloadInvitationCard(data);
        if (label) label.textContent = 'Downloaded ✓';
      } catch (err) {
        console.error('Invitation download failed:', err);
        if (label) label.textContent = 'Try again';
      } finally {
        window.setTimeout(() => {
          if (label) label.textContent = original;
          delete btn.dataset.busy;
        }, 2200);
      }
    });
  }
</script>

<style>
  .inv-card {
    border-radius: 18px;
    padding: 20px;
    text-align: center;
  }
  .ic-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--ink);
  }
  .ic-sub {
    font-size: 0.75rem;
    color: var(--ink-label);
    margin-top: 2px;
    margin-bottom: 14px;
  }

  .ic-preview {
    max-width: 260px;
    margin: 0 auto 16px;
    background: var(--cream);
    border: 2px solid rgba(60, 60, 60, 0.4);
    border-radius: 12px;
    padding: 6px;
    box-shadow: var(--shadow-md);
  }
  .ic-preview-frame {
    aspect-ratio: 3 / 4;
    border-radius: 8px;
    overflow: hidden;
    background: #FEFCF7;
    position: relative;
  }
  .ic-preview-inner {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 14px 12px;
    color: var(--ink);
    overflow: hidden;
  }
  .ic-blessing {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.6rem;
    color: var(--gold);
    margin-bottom: 4px;
  }
  .ic-eyebrow {
    font-size: 8px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin-bottom: 6px;
    line-height: 1.4;
  }
  .ic-name {
    font-family: var(--font-script);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--gold);
    margin-top: 2px;
  }
  .ic-parents {
    font-size: 7.5px;
    color: var(--ink-mute);
    margin-top: 1px;
    line-height: 1.3;
    max-width: 96%;
  }
  .ic-amp {
    font-family: var(--font-script);
    font-style: normal;
    font-size: 1.2rem;
    color: var(--gold);
    margin: 4px 0 2px;
    line-height: 1;
  }
  .ic-divider {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin: 8px 0;
  }
  .ic-divider .hr { height: 1px; width: 24px; background: rgba(60, 60, 60, 0.5); }
  .ic-divider .star { color: var(--gold); font-size: 9px; }
  .ic-when {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 0.72rem;
    color: var(--gold);
  }
  .ic-time {
    font-size: 8px;
    color: var(--ink-mute);
    margin-top: 1px;
  }
  .ic-venue {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.72rem;
    color: var(--ink);
    margin-top: 6px;
  }
  .ic-venue-addr {
    font-size: 7.5px;
    color: var(--ink-mute);
    margin-top: 1px;
    line-height: 1.3;
  }
  .ic-msg {
    margin-top: 6px;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 8px;
    color: var(--ink-mute);
    max-width: 92%;
    line-height: 1.4;
  }

  .ic-btn {
    min-width: 200px;
    padding: 11px 20px;
    font-size: 0.78rem;
  }
  .ic-btn svg { color: var(--gold-pale); }
</style>
