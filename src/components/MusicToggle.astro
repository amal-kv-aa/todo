---
---

<button
  class="music-toggle glass-pill"
  data-music-toggle
  type="button"
  aria-pressed="false"
  aria-label="Play background music"
  title="Music"
>
  <span class="m-label">Music</span>
  <svg class="m-ico m-ico-muted" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M11 4.702a.7.7 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.7.7 0 0 0 11 19.298z"/>
    <path d="m16.5 14.5 5-5"/><path d="m16.5 9.5 5 5"/>
  </svg>
  <svg class="m-ico m-ico-playing" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/>
  </svg>
</button>

<style>
  .music-toggle {
    position: fixed;
    top: calc(14px + env(safe-area-inset-top));
    right: calc(14px + env(safe-area-inset-right));
    z-index: 60;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 6px 12px;
    border-radius: 999px;
    cursor: pointer;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: background 0.3s ease, transform 0.15s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .music-toggle:hover { background: #fff; }
  .music-toggle:active { transform: scale(0.95); }
  .music-toggle:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .m-label {
    color: var(--ink-mute);
    font-size: 10px;
  }
  .m-ico { color: var(--ink-caption); }
  .m-ico-playing { display: none; }
  .music-toggle[aria-pressed='true'] .m-ico-muted { display: none; }
  .music-toggle[aria-pressed='true'] .m-ico-playing { display: inline; color: var(--gold); }
  @media (max-width: 380px) {
    .m-label { display: none; }
    .music-toggle { padding: 6px 10px; }
  }
</style>
