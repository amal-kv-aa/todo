---
// Reusable elegant SVG ornaments (gold line-art). Lightweight, inline, themeable.
interface Props {
  type?: 'flourish' | 'leaf' | 'monogram-sprig' | 'corner';
  class?: string;
}
const { type = 'flourish', class: className = '' } = Astro.props;
---

{
  type === 'flourish' && (
    <svg class={className} viewBox="0 0 120 24" fill="none" aria-hidden="true">
      <path
        d="M4 12c14 0 20-8 28-8s10 8 16 8 8-8 16-8 14 8 28 8"
        stroke="currentColor"
        stroke-width="1.3"
        stroke-linecap="round"
      />
      <circle cx="60" cy="12" r="2.4" fill="currentColor" />
      <circle cx="12" cy="12" r="1.3" fill="currentColor" />
      <circle cx="108" cy="12" r="1.3" fill="currentColor" />
    </svg>
  )
}

{
  type === 'leaf' && (
    <svg class={className} viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 2c4 5 6 9 6 13a6 6 0 0 1-12 0c0-4 2-8 6-13Z" stroke="currentColor" stroke-width="1.2" />
      <path d="M12 6v14M12 11l4-3M12 15l-4-3M12 18l4-3" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
    </svg>
  )
}

{
  type === 'monogram-sprig' && (
    <svg class={className} viewBox="0 0 60 40" fill="none" aria-hidden="true">
      <path d="M30 4v32" stroke="currentColor" stroke-width="1" />
      <path d="M30 12c-6-2-10-1-14-5M30 12c6-2 10-1 14-5M30 22c-7-2-11 0-16-5M30 22c7-2 11 0 16-5M30 32c-5-2-8 0-12-4M30 32c5-2 8 0 12-4"
        stroke="currentColor" stroke-width="1" stroke-linecap="round" />
      <circle cx="30" cy="4" r="2" fill="currentColor" />
    </svg>
  )
}

{
  type === 'corner' && (
    <svg class={className} viewBox="0 0 90 90" fill="none" aria-hidden="true">
      <path
        d="M6 84V40c0-18 16-34 34-34h44"
        stroke="currentColor"
        stroke-width="1.2"
      />
      <path
        d="M16 84V44c0-14 12-26 26-26h42"
        stroke="currentColor"
        stroke-width="0.8"
        opacity="0.7"
      />
      <path d="M40 18c-3-6-1-10 2-14 2 5 1 9-2 14ZM40 18c6-3 10-1 14 2-5 2-9 1-14-2Z"
        stroke="currentColor" stroke-width="0.9" />
      <circle cx="40" cy="18" r="1.8" fill="currentColor" />
    </svg>
  )
}
