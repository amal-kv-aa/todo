---
import { weddingDate } from '../data/format';

interface Props {
  /** Minimal, flat styling for the parchment welcome card (no glass cards). */
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
---

<div class={`countdown ${minimal ? 'countdown--minimal' : ''}`} data-target={weddingDate.iso} aria-live="polite">
  {
    minimal ? (
      <div class="cd-min" data-cd-live>
        <div class="cd-m-unit">
          <span class="cd-m-val" data-days>—</span>
          <span class="cd-m-lab">Days</span>
        </div>
        <div class="cd-m-unit">
          <span class="cd-m-val" data-hours>00</span>
          <span class="cd-m-lab">Hrs</span>
        </div>
        <div class="cd-m-unit">
          <span class="cd-m-val" data-minutes>00</span>
          <span class="cd-m-lab">Min</span>
        </div>
        <div class="cd-m-unit">
          <span class="cd-m-val" data-seconds>00</span>
          <span class="cd-m-lab">Sec</span>
        </div>
      </div>
    ) : (
      <>
        <div class="cd-card cd-days glass-card reveal" data-cd-live>
          <div class="cd-number" data-days>—</div>
          <div class="cd-label">Days to Go</div>
        </div>
        <div class="cd-card cd-time glass-card reveal" data-cd-live>
          <div class="cd-time-grid">
            <div class="cd-unit"><span class="cd-val" data-hours>00</span><span class="cd-unit-label">Hours</span></div>
            <span class="cd-colon">:</span>
            <div class="cd-unit"><span class="cd-val" data-minutes>00</span><span class="cd-unit-label">Minutes</span></div>
            <span class="cd-colon">:</span>
            <div class="cd-unit"><span class="cd-val" data-seconds>00</span><span class="cd-unit-label">Seconds</span></div>
          </div>
          <div class="cd-label">Until We Say "I Do"</div>
        </div>
      </>
    )
  }

  <!-- Shown when the countdown reaches zero -->
  <div class={`cd-arrived ${minimal ? 'cd-arrived--min' : 'glass-card'} reveal`} data-arrived hidden>
    <span class="script">The day is here</span>
    <p>Our celebration has begun — thank you for being part of it.</p>
  </div>
</div>

<style>
  .countdown {
    display: grid;
    grid-template-columns: 1fr 1.4fr;
    gap: 18px;
    margin-top: 10px;
  }
  .cd-card {
    border-radius: 20px;
    padding: 22px 18px;
    text-align: center;
  }
  .cd-days {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }
  .cd-number {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.2rem, 14vw, 4.6rem);
    line-height: 1;
    color: var(--gold-deep);
  }
  .cd-label {
    font-size: 0.68rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--muted-gold);
    margin-top: 10px;
    font-weight: 600;
  }
  .cd-time {
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .cd-time-grid {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 6px;
  }
  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 58px;
  }
  .cd-val {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.1rem, 9vw, 2.9rem);
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .cd-unit-label {
    font-size: 0.56rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-soft);
    margin-top: 8px;
  }
  .cd-colon {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 8vw, 2.6rem);
    color: var(--gold-soft);
    line-height: 1.1;
  }
  .cd-arrived {
    grid-column: 1 / -1;
    text-align: center;
    border-radius: 20px;
    padding: 26px 20px;
  }
  .cd-arrived .script {
    font-size: 2.4rem;
    display: block;
    margin-bottom: 6px;
  }
  .cd-arrived p {
    color: var(--ink-soft);
  }

  /* ── Minimal variant (parchment welcome card) ──────────────────────────── */
  .countdown--minimal {
    display: block;
    margin-top: 0;
  }
  .cd-min {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: clamp(10px, 4vw, 20px);
  }
  .cd-m-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 46px;
  }
  .cd-m-val {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.6rem, 7vw, 2.1rem);
    line-height: 1;
    color: var(--p-gold-deep, #8a6a2f);
    font-variant-numeric: tabular-nums;
  }
  .cd-m-lab {
    font-size: 0.56rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--p-ink, #6b5433);
    margin-top: 7px;
  }
  .cd-arrived--min {
    text-align: center;
    padding: 4px 0;
  }
  .cd-arrived--min .script {
    font-size: 1.8rem;
    display: block;
    color: var(--p-gold-deep, #8a6a2f);
  }
  .cd-arrived--min p {
    color: var(--p-ink, #6b5433);
    font-size: 0.82rem;
    margin-top: 2px;
  }

  @media (max-width: 540px) {
    .countdown:not(.countdown--minimal) {
      grid-template-columns: 1fr;
    }
    .cd-unit {
      min-width: 0;
      flex: 1;
    }
  }
</style>

<script>
  function initCountdown(root: HTMLElement) {
    const target = new Date(root.dataset.target || '').getTime();
    if (Number.isNaN(target)) return;

    const daysEl = root.querySelector('[data-days]') as HTMLElement | null;
    const hoursEl = root.querySelector('[data-hours]') as HTMLElement | null;
    const minsEl = root.querySelector('[data-minutes]') as HTMLElement | null;
    const secsEl = root.querySelector('[data-seconds]') as HTMLElement | null;
    const liveEls = Array.from(root.querySelectorAll<HTMLElement>('[data-cd-live]'));
    const arrived = root.querySelector('[data-arrived]') as HTMLElement | null;

    const pad = (n: number) => String(n).padStart(2, '0');
    let timer = 0;

    function tick() {
      const now = Date.now();
      let diff = Math.floor((target - now) / 1000);

      if (diff <= 0) {
        // Countdown reached zero — reveal the celebratory message.
        liveEls.forEach((el) => (el.hidden = true));
        if (arrived) arrived.hidden = false;
        window.clearInterval(timer);
        return;
      }

      const days = Math.floor(diff / 86400);
      diff -= days * 86400;
      const hours = Math.floor(diff / 3600);
      diff -= hours * 3600;
      const mins = Math.floor(diff / 60);
      const secs = diff - mins * 60;

      if (daysEl) daysEl.textContent = String(days);
      if (hoursEl) hoursEl.textContent = pad(hours);
      if (minsEl) minsEl.textContent = pad(mins);
      if (secsEl) secsEl.textContent = pad(secs);
    }

    tick();
    timer = window.setInterval(tick, 1000);
  }

  document.querySelectorAll<HTMLElement>('.countdown').forEach((el) => initCountdown(el));
</script>
