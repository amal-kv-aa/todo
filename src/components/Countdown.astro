---
import { weddingDate } from '../data/format';

interface Props {
  /** Compact gold-pill countdown shown on the cover. */
  minimal?: boolean;
}
const { minimal = false } = Astro.props;
---

<div class={`countdown ${minimal ? 'countdown--minimal' : ''}`} data-target={weddingDate.iso} aria-live="polite">
  <div class="cd-row" data-cd-live>
    <div class="cd-cell">
      <div class="cd-box"><span class="cd-val" data-days>00</span></div>
      <span class="cd-lab">Days</span>
    </div>
    <span class="cd-sep">:</span>
    <div class="cd-cell">
      <div class="cd-box"><span class="cd-val" data-hours>00</span></div>
      <span class="cd-lab">Hours</span>
    </div>
    <span class="cd-sep">:</span>
    <div class="cd-cell">
      <div class="cd-box"><span class="cd-val" data-minutes>00</span></div>
      <span class="cd-lab">Minutes</span>
    </div>
    <span class="cd-sep">:</span>
    <div class="cd-cell">
      <div class="cd-box"><span class="cd-val" data-seconds>00</span></div>
      <span class="cd-lab">Seconds</span>
    </div>
  </div>

  <div class="cd-arrived" data-arrived hidden>
    <p class="cd-arrived-title">The day is here</p>
    <p class="cd-arrived-sub">Our celebration has begun — thank you for being part of it.</p>
  </div>
</div>

<style>
  .countdown {
    display: flex;
    justify-content: center;
    width: 100%;
  }
  .cd-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }
  @media (min-width: 420px) {
    .cd-row { gap: 12px; }
  }

  .cd-cell {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .cd-box {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg,
      rgba(252, 239, 222, 0.92),
      rgba(236, 232, 224, 0.86) 45%,
      rgba(210, 210, 212, 0.80) 100%);
    border: 1px solid rgba(60, 60, 60, 0.2);
    box-shadow: inset 0 2px 0 0 hsla(0, 0%, 100%, 0.9),
                0 4px 14px rgba(90, 66, 49, 0.08);
  }
  @media (min-width: 420px) {
    .cd-box { width: 62px; height: 62px; }
  }

  .cd-val {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1;
    color: var(--ink);
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  @media (min-width: 420px) {
    .cd-val { font-size: 1.8rem; }
  }
  .cd-lab {
    font-size: 10px;
    color: var(--ink-label);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    font-weight: 600;
    margin-top: 5px;
  }
  @media (min-width: 420px) {
    .cd-lab { font-size: 11px; }
  }
  .cd-sep {
    color: rgba(60, 60, 60, 0.6);
    font-family: var(--font-serif);
    font-size: 1rem;
    margin-bottom: 16px;
    user-select: none;
  }

  .cd-arrived {
    text-align: center;
    width: 100%;
    padding: 6px 0;
  }
  .cd-arrived-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.4rem;
    color: var(--gold);
    line-height: 1.2;
  }
  .cd-arrived-sub {
    color: var(--ink-soft);
    font-size: 0.85rem;
    margin-top: 4px;
  }
</style>

<script>
  function initCountdown(root: HTMLElement) {
    const target = new Date(root.dataset.target || '').getTime();
    if (Number.isNaN(target)) return;

    const daysEl = root.querySelector('[data-days]') as HTMLElement | null;
    const hoursEl = root.querySelector('[data-hours]') as HTMLElement | null;
    const minsEl = root.querySelector('[data-minutes]') as HTMLElement | null;
    const secsEl = root.querySelector('[data-seconds]') as HTMLElement | null;
    const liveEl = root.querySelector('[data-cd-live]') as HTMLElement | null;
    const arrived = root.querySelector('[data-arrived]') as HTMLElement | null;

    const pad = (n: number) => String(n).padStart(2, '0');
    let timer = 0;

    function tick() {
      const now = Date.now();
      let diff = Math.floor((target - now) / 1000);

      if (diff <= 0) {
        if (liveEl) liveEl.hidden = true;
        if (arrived) arrived.hidden = false;
        window.clearInterval(timer);
        return;
      }

      const days = Math.floor(diff / 86400);
      diff -= days * 86400;
      const hours = Math.floor(diff / 3600);
      diff -= hours * 3600;
      const mins = Math.floor(diff / 60);
      const secs = diff - mins * 60;

      if (daysEl) daysEl.textContent = pad(days);
      if (hoursEl) hoursEl.textContent = pad(hours);
      if (minsEl) minsEl.textContent = pad(mins);
      if (secsEl) secsEl.textContent = pad(secs);
    }

    tick();
    timer = window.setInterval(tick, 1000);
  }

  document.querySelectorAll<HTMLElement>('.countdown').forEach((el) => initCountdown(el));
</script>
