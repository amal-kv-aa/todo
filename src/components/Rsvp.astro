---
// ─────────────────────────────────────────────────────────────────────────────
// RSVP — Netlify Forms-backed.
//
// Submissions are collected by Netlify (no backend needed). The couple can view
// and export them from the Netlify dashboard → Forms → "rsvp".
//
// How Netlify detects this form at deploy time:
//   • A plain <form name="rsvp" data-netlify="true" netlify-honeypot="bot-field">
//     renders into the production HTML during `astro build`. Netlify's post-
//     processor scans the built HTML for these attributes and registers the form.
//   • A hidden `form-name` input is required so AJAX submissions to "/" are
//     routed to the right form on Netlify's side.
//   • A honeypot field (`bot-field`) silently rejects bot traffic.
//
// This component submits via fetch so the guest stays on the page and sees the
// styled success state. It also still works without JavaScript — the native
// form POST goes to Netlify directly, which stores the submission and shows
// Netlify's built-in success page.
// ─────────────────────────────────────────────────────────────────────────────
import { wedding } from '../data/wedding';

const { groom, bride } = wedding.couple;
---

<section class="rsvp reveal" id="rsvp" aria-labelledby="rsvp-heading">
  <div class="rsvp-title">
    <h3 id="rsvp-heading">RSVP</h3>
    <p>Please let {groom.firstName} &amp; {bride.firstName} know if you&rsquo;ll be joining us</p>
  </div>

  <div class="rsvp-card liquid-glass-gold" data-rsvp-card>
      <!--
        Netlify Forms contract:
          - `name="rsvp"` is the form id in Netlify's dashboard
          - `data-netlify="true"` opts the form into Netlify's form handling
          - `netlify-honeypot="bot-field"` silently drops bot submissions that
            fill the hidden decoy field
          - Hidden `form-name` input is required for AJAX / fetch submissions
      -->
      <form
        class="rsvp-form"
        name="rsvp"
        method="POST"
        action="/?rsvp=success#rsvp"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-rsvp-form
      >
        <input type="hidden" name="form-name" value="rsvp" />

        <!-- Honeypot: hidden from humans, catnip for bots -->
        <p class="hp-field" aria-hidden="true">
          <label>
            Don&rsquo;t fill this out if you&rsquo;re human:
            <input name="bot-field" tabindex="-1" autocomplete="off" />
          </label>
        </p>

        <fieldset class="rsvp-field attendance-field">
          <legend class="rsvp-label">Will you be attending?</legend>

          <div class="attendance-options">
            <label class="attendance-opt">
              <input type="radio" name="attending" value="Joyfully Accept" required />
              <span class="opt-card">
                <span class="opt-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                    <path
                      d="M20 7.5a3 3 0 0 0-5-2.2L12 8.1 9 5.3a3 3 0 1 0-4.1 4.3l6.4 6.1a1 1 0 0 0 1.4 0l6.4-6.1A3 3 0 0 0 20 7.5Z"
                      fill="currentColor"
                    />
                  </svg>
                </span>
                <span class="opt-title">Joyfully Accept</span>
              </span>
            </label>

            <label class="attendance-opt">
              <input type="radio" name="attending" value="Unable to Attend" required />
              <span class="opt-card">
                <span class="opt-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
                    <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16Z"
                          fill="currentColor"/>
                    <path d="M8 12h8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                  </svg>
                </span>
                <span class="opt-title">Unable to Attend</span>
              </span>
            </label>
          </div>
        </fieldset>

        <!-- Attendees count — only shown when "Joyfully Accept" is selected -->
        <div class="rsvp-field attendees-field" data-attendees-field hidden>
          <label class="rsvp-label" for="rsvp-attendees">Number of attendees</label>
          <div class="counter" role="group" aria-label="Number of attendees">
            <button type="button" class="counter-btn" data-count-dec aria-label="Decrease attendees">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                <path d="M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
            <input
              id="rsvp-attendees"
              class="counter-value"
              type="number"
              name="attendees"
              min="1"
              max="20"
              step="1"
              value="1"
              inputmode="numeric"
              aria-live="polite"
            />
            <button type="button" class="counter-btn" data-count-inc aria-label="Increase attendees">
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
                <path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              </svg>
            </button>
          </div>
        </div>

        <div class="rsvp-field">
          <label class="rsvp-label" for="rsvp-name">Your name</label>
          <input
            id="rsvp-name"
            class="rsvp-input"
            type="text"
            name="guestName"
            required
            maxlength="80"
            autocomplete="name"
            placeholder="Full name"
          />
        </div>

        <div class="rsvp-actions">
          <button class="btn-dark rsvp-submit" type="submit" data-rsvp-submit>
            <span class="submit-spinner" aria-hidden="true"></span>
            <span data-rsvp-submit-label>Submit RSVP</span>
          </button>
          <p class="rsvp-error" data-rsvp-error hidden role="alert">
            We couldn&rsquo;t send your RSVP just now. Please try again, or reach out to us directly.
          </p>
        </div>
      </form>

      <!-- Success state (revealed after a successful submit) -->
      <div class="rsvp-success" data-rsvp-success hidden role="status" aria-live="polite">
        <div class="success-check" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none">
            <path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="2.4"
                  stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </div>
        <h3 class="success-title" data-rsvp-success-msg>Thank you!</h3>
        <p class="success-sub" data-rsvp-success-sub>
          Your RSVP has been received.
        </p>

        <button type="button" class="success-reset" data-rsvp-reset>
          Need to update your reply?
        </button>
      </div>
  </div>
</section>

<style>
  /* RSVP — restyled for the cream & gold theme; functionality preserved. */
  .rsvp {
    margin-bottom: 8px;
  }
  .rsvp-title {
    text-align: center;
    margin-bottom: 12px;
  }
  .rsvp-title h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.25rem, 5vw, 1.5rem);
    color: var(--ink);
  }
  .rsvp-title p {
    font-size: 0.75rem;
    color: var(--ink-label);
    margin-top: 2px;
  }

  .rsvp-card {
    margin: 0 auto;
    border-radius: 18px;
    padding: 20px;
  }

  /* Honeypot: visually hidden, no scroll impact */
  .hp-field {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    margin: -1px;
    padding: 0;
    border: 0;
  }

  .rsvp-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
    min-width: 0;
    /* Any tap inside the form (buttons, inputs, radios, bare padding) registers
       as a click, never a double-tap-zoom gesture. Pinch-zoom still works, so
       accessibility isn't affected. */
    touch-action: manipulation;
    -webkit-tap-highlight-color: transparent;
  }
  .rsvp-field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }
  .rsvp-label {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--ink-label);
    text-transform: uppercase;
  }

  /* ── Attendance options: compact pill-row on mobile ───────────────────── */
  .attendance-options {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .attendance-opt {
    position: relative;
    cursor: pointer;
    display: block;
    min-width: 0;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .attendance-opt > input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
    width: 0;
    height: 0;
  }
  .opt-card {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-radius: 12px;
    border: 1px solid rgba(60, 60, 60, 0.3);
    background: rgba(255, 255, 255, 0.5);
    color: var(--ink-soft);
    transition: background 0.2s ease, border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .opt-icon {
    display: inline-flex;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    color: var(--gold);
    background: var(--cream);
    border: 1px solid rgba(60, 60, 60, 0.3);
    flex-shrink: 0;
  }
  .opt-icon svg { display: block; }
  .opt-title {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: var(--ink);
    font-weight: 700;
    line-height: 1.2;
  }
  .attendance-opt > input:focus-visible + .opt-card {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }
  .attendance-opt > input:checked + .opt-card {
    border-color: var(--btn-dark);
    background: #fff;
    box-shadow: inset 0 0 0 1px var(--btn-dark);
  }
  .attendance-opt > input:checked + .opt-card .opt-icon {
    background: var(--btn-dark);
    border-color: var(--btn-dark);
    color: var(--gold-pale);
  }

  /* ── Attendees counter ───────────────────────────────────────────────── */
  .attendees-field[hidden] { display: none; }
  .counter {
    display: inline-flex;
    align-items: center;
    border: 1px solid rgba(60, 60, 60, 0.4);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.6);
    width: fit-content;
  }
  .counter-btn {
    appearance: none;
    border: 0;
    background: transparent;
    width: 38px;
    height: 38px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--gold);
    transition: background 0.2s ease;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
    user-select: none;
    -webkit-user-select: none;
  }
  .counter-btn:hover { background: var(--cream); }
  .counter-btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: -2px;
  }
  .counter-btn:disabled {
    opacity: 0.35;
    cursor: not-allowed;
  }
  .counter-value {
    width: 44px;
    text-align: center;
    border: 0;
    background: transparent;
    font-family: var(--font-serif);
    font-size: 1.1rem;
    color: var(--ink);
    font-weight: 700;
    padding: 0;
    -moz-appearance: textfield;
    appearance: textfield;
  }
  .counter-value::-webkit-outer-spin-button,
  .counter-value::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  .counter-value:focus-visible { outline: none; }

  /* ── Text input ─────────────────────────────────────────────────────── */
  .rsvp-input {
    appearance: none;
    border: 1px solid rgba(60, 60, 60, 0.4);
    background: rgba(255, 255, 255, 0.7);
    border-radius: 12px;
    padding: 11px 14px;
    font-family: var(--font-body);
    font-size: 0.95rem;
    color: var(--ink);
    transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    min-width: 0;
    width: 100%;
  }
  .rsvp-input::placeholder {
    color: var(--ink-caption);
  }
  .rsvp-input:focus-visible {
    outline: none;
    border-color: var(--btn-dark);
    background: #fff;
    box-shadow: 0 0 0 3px rgba(60, 60, 60, 0.25);
  }

  /* ── Submit button & states ──────────────────────────────────────────── */
  .rsvp-actions {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 8px;
    margin-top: 6px;
  }
  /* Scope the base button down for mobile — the global .btn-gold is
     deliberately large for the headline CTAs; here we want it modest. */
  .rsvp-submit {
    justify-content: center;
    padding: 12px 24px;
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    width: 100%;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }
  .rsvp-submit[data-busy] {
    cursor: progress;
    pointer-events: none;
    filter: brightness(0.95);
  }
  .rsvp-submit[data-busy] .submit-spinner { display: inline-block; }
  .submit-spinner {
    display: none;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    border: 2px solid rgba(255, 255, 255, 0.4);
    border-top-color: #fff;
    animation: rsvp-spin 0.7s linear infinite;
  }
  @keyframes rsvp-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    .submit-spinner { animation: none; }
  }

  .rsvp-error {
    color: #a2451d;
    font-size: 0.85rem;
    text-align: center;
    line-height: 1.4;
    margin: 2px 0 0;
  }

  /* ── Success state ───────────────────────────────────────────────────── */
  .rsvp-form[hidden],
  .rsvp-success[hidden] { display: none; }
  .rsvp-success {
    text-align: center;
    padding: 10px 4px 4px;
    animation: rsvp-success-in 0.6s ease-out both;
  }
  .success-check {
    display: inline-flex;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    align-items: center;
    justify-content: center;
    background: var(--btn-dark);
    color: var(--gold-pale);
    margin: 0 auto 12px;
    box-shadow: 0 6px 18px rgba(90, 66, 49, 0.2);
  }
  .success-title {
    font-family: var(--font-display);
    font-size: 1.3rem;
    color: var(--ink);
    margin: 0 0 6px;
    line-height: 1.2;
    font-weight: 700;
  }
  .success-sub {
    color: var(--ink-soft);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.5;
    max-width: 320px;
    margin: 0 auto;
  }
  .success-reset {
    appearance: none;
    background: transparent;
    border: 0;
    margin-top: 16px;
    padding: 6px 10px;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-label);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(60, 60, 60, 0.5);
  }
  .success-reset:hover {
    color: var(--ink);
    text-decoration-color: var(--gold);
  }
  .success-reset:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
    border-radius: 4px;
  }
  @keyframes rsvp-success-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    .rsvp-success { animation: none; }
  }

  @media (min-width: 560px) {
    .rsvp-card { padding: 24px; }
    .attendance-options { flex-direction: row; }
    .attendance-opt { flex: 1; min-width: 0; }
    .opt-card { padding: 12px 14px; }
  }
</style>

<script>
  // ──────────────────────────────────────────────────────────────────────────
  // Client-side RSVP wiring
  //
  //   • Toggles the attendee counter based on "Joyfully Accept"
  //   • Submits via fetch so the guest stays on the page
  //   • Encodes as application/x-www-form-urlencoded (what Netlify expects)
  //   • Hard-blocks duplicate submissions in three layers:
  //       1. a per-form in-memory flag
  //       2. `button.disabled` during the request
  //       3. a localStorage breadcrumb that pre-fills the success state on
  //          return visits from the same device
  // ──────────────────────────────────────────────────────────────────────────
  const SUBMITTED_KEY = 'wedding-rsvp-submitted-v1';

  const form = document.querySelector<HTMLFormElement>('[data-rsvp-form]');
  const card = document.querySelector<HTMLElement>('[data-rsvp-card]');
  const success = document.querySelector<HTMLElement>('[data-rsvp-success]');
  const successMsg = document.querySelector<HTMLElement>('[data-rsvp-success-msg]');
  const successSub = document.querySelector<HTMLElement>('[data-rsvp-success-sub]');
  const submitBtn = document.querySelector<HTMLButtonElement>('[data-rsvp-submit]');
  const submitLabel = document.querySelector<HTMLElement>('[data-rsvp-submit-label]');
  const errorEl = document.querySelector<HTMLElement>('[data-rsvp-error]');
  const attendeesField = document.querySelector<HTMLElement>('[data-attendees-field]');
  const attendeesInput = document.querySelector<HTMLInputElement>('#rsvp-attendees');
  const decBtn = document.querySelector<HTMLButtonElement>('[data-count-dec]');
  const incBtn = document.querySelector<HTMLButtonElement>('[data-count-inc]');
  const resetBtn = document.querySelector<HTMLButtonElement>('[data-rsvp-reset]');

  // Keep the last submission around so the "update your reply" flow can prefill
  // the form instead of making the guest retype everything.
  let lastPayload: { attending?: string; attendees?: string; guestName?: string } | null = null;

  function showSuccess(payload?: { attending?: string; attendees?: string; guestName?: string }) {
    if (!form || !success) return;
    if (payload) lastPayload = payload;
    form.hidden = true;
    success.hidden = false;

    if (payload && successMsg && successSub) {
      const name = (payload.guestName || '').trim().split(/\s+/)[0] || 'Dear guest';
      if (payload.attending === 'Unable to Attend') {
        successMsg.textContent = `We’ll miss you, ${name}.`;
        successSub.textContent =
          'Thank you for letting us know. You’ll be in our hearts on the day.';
      } else {
        const n = Number.parseInt(payload.attendees || '1', 10) || 1;
        successMsg.textContent = `See you soon, ${name}!`;
        successSub.textContent =
          n > 1
            ? `We’ve got you (and ${n - 1} more) on the list — can’t wait to celebrate.`
            : 'We’ve got you on the list — can’t wait to celebrate.';
      }
    }
  }

  // Reset the success state and return the guest to the form, prefilled with
  // whatever they previously submitted. Clears the localStorage breadcrumb too,
  // so a reload won't drop them straight back into the success view.
  function resetToForm() {
    if (!form || !success) return;
    success.hidden = true;
    form.hidden = false;

    submitting = false;
    if (submitBtn) {
      submitBtn.disabled = false;
      delete submitBtn.dataset.busy;
    }
    if (submitLabel) submitLabel.textContent = 'Submit RSVP';
    if (errorEl) errorEl.hidden = true;

    if (lastPayload) {
      const nameInput = form.querySelector<HTMLInputElement>('#rsvp-name');
      if (nameInput) nameInput.value = lastPayload.guestName || '';
      if (lastPayload.attending) {
        const radio = form.querySelector<HTMLInputElement>(
          `input[name="attending"][value="${CSS.escape(lastPayload.attending)}"]`,
        );
        if (radio) radio.checked = true;
      }
      if (lastPayload.attendees) setAttendees(Number(lastPayload.attendees) || 1);
    }
    syncAttendeesVisibility();

    try { localStorage.removeItem(SUBMITTED_KEY); } catch { /* ignore */ }

    form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    form.querySelector<HTMLInputElement>('#rsvp-name')?.focus({ preventScroll: true });
  }
  resetBtn?.addEventListener('click', resetToForm);

  // If a previous visit already submitted on this device, skip straight to success.
  try {
    const stored = localStorage.getItem(SUBMITTED_KEY);
    if (stored) {
      const parsed = JSON.parse(stored);
      showSuccess(parsed);
    }
  } catch { /* ignore storage failures — form stays interactive */ }

  // Also show success when Netlify redirects us back with ?rsvp=success
  // (the no-JS fallback path, if the fetch submit couldn't run).
  if (new URLSearchParams(location.search).get('rsvp') === 'success') {
    showSuccess();
  }

  // ── Attendance toggle: show the counter only when the guest is coming ──
  function syncAttendeesVisibility() {
    if (!form || !attendeesField) return;
    const picked = (form.elements.namedItem('attending') as RadioNodeList | null)?.value;
    const attending = picked === 'Joyfully Accept';
    attendeesField.hidden = !attending;
    if (attendeesInput) attendeesInput.required = attending;
  }
  form?.addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement)?.name === 'attending') syncAttendeesVisibility();
  });
  syncAttendeesVisibility();

  // ── Counter buttons ─────────────────────────────────────────────────────
  function clampAttendees(v: number): number {
    if (!Number.isFinite(v)) return 1;
    return Math.max(1, Math.min(20, Math.floor(v)));
  }
  function setAttendees(n: number) {
    if (!attendeesInput) return;
    const c = clampAttendees(n);
    attendeesInput.value = String(c);
    if (decBtn) decBtn.disabled = c <= 1;
    if (incBtn) incBtn.disabled = c >= 20;
  }
  decBtn?.addEventListener('click', () => setAttendees(Number(attendeesInput?.value || 1) - 1));
  incBtn?.addEventListener('click', () => setAttendees(Number(attendeesInput?.value || 1) + 1));
  attendeesInput?.addEventListener('input', () => setAttendees(Number(attendeesInput.value || 1)));
  setAttendees(Number(attendeesInput?.value || 1));

  // ── Submit via fetch ────────────────────────────────────────────────────
  let submitting = false;
  form?.addEventListener('submit', async (e) => {
    if (!form || !submitBtn) return;
    e.preventDefault();
    if (submitting) return;

    // HTML5 validation first — the browser's own red UI if a field is empty/invalid.
    if (!form.reportValidity()) return;

    submitting = true;
    submitBtn.dataset.busy = '1';
    submitBtn.disabled = true;
    if (submitLabel) submitLabel.textContent = 'Sending…';
    if (errorEl) errorEl.hidden = true;

    const data = new FormData(form);
    // If the guest declined, Netlify would store an empty "attendees"; strip it
    // so the dashboard column stays meaningful.
    if (data.get('attending') !== 'Joyfully Accept') {
      data.delete('attendees');
    }

    const body = new URLSearchParams();
    data.forEach((value, key) => body.append(key, value.toString()));

    try {
      const response = await fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: body.toString(),
      });
      if (!response.ok) throw new Error(`Netlify responded ${response.status}`);

      const payload = {
        attending: String(data.get('attending') || ''),
        attendees: String(data.get('attendees') || '1'),
        guestName: String(data.get('guestName') || ''),
      };
      try {
        localStorage.setItem(SUBMITTED_KEY, JSON.stringify(payload));
      } catch { /* storage blocked — in-memory success still works */ }
      showSuccess(payload);
    } catch (err) {
      console.error('RSVP submit failed:', err);
      submitting = false;
      submitBtn.disabled = false;
      delete submitBtn.dataset.busy;
      if (submitLabel) submitLabel.textContent = 'Submit RSVP';
      if (errorEl) errorEl.hidden = false;
    }
  });
</script>
