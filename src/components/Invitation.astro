---
import { wedding } from '../data/wedding';
import { weddingDate } from '../data/format';
import Ornament from './Ornament.astro';
import Venue from './Venue.astro';
import InvitationCard from './InvitationCard.astro';

const { groom, bride } = wedding.couple;

const details: { label: string; value: string }[] = [
  { label: 'Date', value: `${weddingDate.monthLong} ${weddingDate.day}, ${weddingDate.year}` },
  { label: 'Day', value: weddingDate.weekday },
  { label: 'Time', value: weddingDate.time },
  { label: 'Venue', value: wedding.venue.name },
  { label: 'Address', value: wedding.venue.address },
  ...(wedding.extraDetails ?? []),
];
---

<section class="invitation" id="invitation" aria-label="Wedding invitation" hidden>
  <!-- Flower bouquets with hanging lamps at the top corners.
       The right side is the same artwork mirrored via scaleX(-1) in CSS. -->
  <svg class="bouquet bouquet-left" viewBox="0 0 170 230" aria-hidden="true" preserveAspectRatio="xMinYMin meet">
    <defs>
      <linearGradient id="bq-brass" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#e2b872"/>
        <stop offset="45%" stop-color="#b0894a"/>
        <stop offset="100%" stop-color="#6a4e22"/>
      </linearGradient>
      <linearGradient id="bq-brass-side" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0%" stop-color="#8a6a2f"/>
        <stop offset="50%" stop-color="#dfb66d"/>
        <stop offset="100%" stop-color="#8a6a2f"/>
      </linearGradient>
      <radialGradient id="bq-flame" cx="50%" cy="55%" r="55%">
        <stop offset="0%" stop-color="#fff5d8"/>
        <stop offset="40%" stop-color="#f4c870"/>
        <stop offset="100%" stop-color="#c88a2a" stop-opacity="0"/>
      </radialGradient>
      <radialGradient id="bq-halo" cx="50%" cy="50%" r="50%">
        <stop offset="0%" stop-color="#ffdfa0" stop-opacity="0.75"/>
        <stop offset="60%" stop-color="#e8a95a" stop-opacity="0.18"/>
        <stop offset="100%" stop-color="#e8a95a" stop-opacity="0"/>
      </radialGradient>

      <symbol id="bq-marigold" viewBox="-20 -20 40 40">
        <g>
          <circle r="10" fill="#b56a1f"/>
          <g fill="#d99a4a">
            <circle cx="0" cy="-10" r="5"/><circle cx="7" cy="-7" r="5"/>
            <circle cx="10" cy="0" r="5"/><circle cx="7" cy="7" r="5"/>
            <circle cx="0" cy="10" r="5"/><circle cx="-7" cy="7" r="5"/>
            <circle cx="-10" cy="0" r="5"/><circle cx="-7" cy="-7" r="5"/>
          </g>
          <g fill="#e8b566">
            <circle cx="0" cy="-5" r="3"/><circle cx="4" cy="-3" r="3"/>
            <circle cx="5" cy="2" r="3"/><circle cx="0" cy="5" r="3"/>
            <circle cx="-5" cy="2" r="3"/><circle cx="-4" cy="-3" r="3"/>
          </g>
          <circle r="2" fill="#efc98a"/>
        </g>
      </symbol>
      <!-- 5-petal jasmine-style ivory flower (replaces the earlier rose).
           This single symbol is picked up by both bouquets and the hero
           names background via their <use href="#bq-rose"> references. -->
      <symbol id="bq-rose" viewBox="-16 -16 32 32">
        <g>
          <g fill="#f3ead6" stroke="#d9ccae" stroke-width="0.5">
            <path d="M 0 -3 Q -6 -10, 0 -14 Q 6 -10, 0 -3 Z"/>
            <path d="M 0 -3 Q -6 -10, 0 -14 Q 6 -10, 0 -3 Z" transform="rotate(72)"/>
            <path d="M 0 -3 Q -6 -10, 0 -14 Q 6 -10, 0 -3 Z" transform="rotate(144)"/>
            <path d="M 0 -3 Q -6 -10, 0 -14 Q 6 -10, 0 -3 Z" transform="rotate(216)"/>
            <path d="M 0 -3 Q -6 -10, 0 -14 Q 6 -10, 0 -3 Z" transform="rotate(288)"/>
          </g>
          <g fill="#e3d6b4">
            <path d="M 0 -3 Q -3 -8, 0 -10 Q 3 -8, 0 -3 Z"/>
            <path d="M 0 -3 Q -3 -8, 0 -10 Q 3 -8, 0 -3 Z" transform="rotate(72)"/>
            <path d="M 0 -3 Q -3 -8, 0 -10 Q 3 -8, 0 -3 Z" transform="rotate(144)"/>
            <path d="M 0 -3 Q -3 -8, 0 -10 Q 3 -8, 0 -3 Z" transform="rotate(216)"/>
            <path d="M 0 -3 Q -3 -8, 0 -10 Q 3 -8, 0 -3 Z" transform="rotate(288)"/>
          </g>
          <circle r="3" fill="#dfb66d"/>
          <circle r="1.3" fill="#8a4e0c"/>
        </g>
      </symbol>
      <symbol id="bq-bud" viewBox="-8 -8 16 16">
        <circle r="5" fill="#c47a2a"/><circle r="2.5" fill="#e9b568"/>
      </symbol>
      <symbol id="bq-leaf" viewBox="-14 -6 28 12">
        <path d="M-14 0 Q -8 -8 0 -5 Q 8 -2 14 0 Q 8 2 0 5 Q -8 8 -14 0 Z" fill="#7a8a65"/>
        <path d="M-12 0 L 12 0" stroke="#5f6e4f" stroke-width="0.6" fill="none"/>
      </symbol>
    </defs>

    <!-- Leaves (fade in first, soft and quiet) -->
    <g class="bq-leaves">
      <use href="#bq-leaf" x="12"  y="80"  width="38" height="16" transform="rotate(-55 31 88)"/>
      <use href="#bq-leaf" x="60"  y="95"  width="40" height="17" transform="rotate(-20 80 103)"/>
      <use href="#bq-leaf" x="88"  y="54"  width="34" height="14" transform="rotate(35 105 61)"/>
      <use href="#bq-leaf" x="42"  y="110" width="34" height="14" transform="rotate(-80 59 117)"/>
    </g>

    <!-- Flowers blooming in staggered -->
    <g class="bq-flowers">
      <use class="bq-bloom bq-b1" href="#bq-marigold" x="4"  y="4"  width="46" height="46"/>
      <use class="bq-bloom bq-b2" href="#bq-rose"     x="46" y="30" width="32" height="32"/>
      <use class="bq-bloom bq-b3" href="#bq-marigold" x="14" y="46" width="40" height="40"/>
      <use class="bq-bloom bq-b4" href="#bq-bud"      x="76" y="14" width="18" height="18"/>
      <use class="bq-bloom bq-b5" href="#bq-rose"     x="74" y="56" width="30" height="30"/>
      <use class="bq-bloom bq-b6" href="#bq-marigold" x="86" y="28" width="36" height="36"/>
    </g>

    <!-- Hanging lamp dropping from under the cluster -->
    <g class="bq-lamp" transform="translate(72 92)">
      <g class="bq-pivot">
        <path class="bq-cord" d="M 0 0 L 0 70" stroke="#8a6a2f" stroke-width="1" fill="none" stroke-linecap="round"/>
        <g transform="translate(0 70)">
          <g class="bq-body">
            <circle class="bq-halo" r="28" fill="url(#bq-halo)"/>
            <path d="M-9 -7 L 9 -7 L 7 -4 L -7 -4 Z" fill="url(#bq-brass-side)"/>
            <path d="M-11 -4 Q 0 22 11 -4 Z" fill="url(#bq-brass)" stroke="#5a4218" stroke-width="0.6"/>
            <ellipse cx="0" cy="-4" rx="11" ry="2.4" fill="#e2b872" stroke="#5a4218" stroke-width="0.5"/>
            <circle cx="0" cy="4" r="3.6" fill="url(#bq-flame)"/>
          </g>
        </g>
      </g>
    </g>
  </svg>

  <!-- Right bouquet is the same artwork, mirrored horizontally via CSS -->
  <svg class="bouquet bouquet-right" viewBox="0 0 170 230" aria-hidden="true" preserveAspectRatio="xMinYMin meet">
    <g class="bq-leaves">
      <use href="#bq-leaf" x="12"  y="80"  width="38" height="16" transform="rotate(-55 31 88)"/>
      <use href="#bq-leaf" x="60"  y="95"  width="40" height="17" transform="rotate(-20 80 103)"/>
      <use href="#bq-leaf" x="88"  y="54"  width="34" height="14" transform="rotate(35 105 61)"/>
      <use href="#bq-leaf" x="42"  y="110" width="34" height="14" transform="rotate(-80 59 117)"/>
    </g>
    <g class="bq-flowers">
      <use class="bq-bloom bq-b1" href="#bq-marigold" x="4"  y="4"  width="46" height="46"/>
      <use class="bq-bloom bq-b2" href="#bq-rose"     x="46" y="30" width="32" height="32"/>
      <use class="bq-bloom bq-b3" href="#bq-marigold" x="14" y="46" width="40" height="40"/>
      <use class="bq-bloom bq-b4" href="#bq-bud"      x="76" y="14" width="18" height="18"/>
      <use class="bq-bloom bq-b5" href="#bq-rose"     x="74" y="56" width="30" height="30"/>
      <use class="bq-bloom bq-b6" href="#bq-marigold" x="86" y="28" width="36" height="36"/>
    </g>
    <g class="bq-lamp" transform="translate(72 92)">
      <g class="bq-pivot">
        <path class="bq-cord" d="M 0 0 L 0 70" stroke="#8a6a2f" stroke-width="1" fill="none" stroke-linecap="round"/>
        <g transform="translate(0 70)">
          <g class="bq-body">
            <circle class="bq-halo" r="28" fill="url(#bq-halo)"/>
            <path d="M-9 -7 L 9 -7 L 7 -4 L -7 -4 Z" fill="url(#bq-brass-side)"/>
            <path d="M-11 -4 Q 0 22 11 -4 Z" fill="url(#bq-brass)" stroke="#5a4218" stroke-width="0.6"/>
            <ellipse cx="0" cy="-4" rx="11" ry="2.4" fill="#e2b872" stroke="#5a4218" stroke-width="0.5"/>
            <circle cx="0" cy="4" r="3.6" fill="url(#bq-flame)"/>
          </g>
        </g>
      </g>
    </g>
  </svg>

  <!-- Welcome message -->
  <div class="hero">
    <div class="container">
      <p class="eyebrow reveal">Welcome, dear guest</p>

      <div class="names-stage reveal">
        <!-- Floral background framing the names. These `<use>` elements
             reference the symbols already defined in the top-left bouquet
             SVG (#bq-marigold, #bq-rose, #bq-bud, #bq-leaf) — browsers
             resolve IDs document-wide, so no definitions are duplicated. -->
        <svg class="names-bg" viewBox="0 0 640 240" aria-hidden="true"
             preserveAspectRatio="xMidYMid slice">
          <!-- Soft leafy backdrop — faintest layer -->
          <g class="nb-leaves">
            <use href="#bq-leaf" x="20"  y="36"  width="68" height="28"
                 transform="rotate(-25 54 50)"/>
            <use href="#bq-leaf" x="552" y="36"  width="68" height="28"
                 transform="rotate(25 586 50)"/>
            <use href="#bq-leaf" x="110" y="180" width="60" height="25"
                 transform="rotate(28 140 192)"/>
            <use href="#bq-leaf" x="470" y="180" width="60" height="25"
                 transform="rotate(-28 500 192)"/>
            <use href="#bq-leaf" x="220" y="12"  width="48" height="20"
                 transform="rotate(-12 244 22)"/>
            <use href="#bq-leaf" x="372" y="12"  width="48" height="20"
                 transform="rotate(12 396 22)"/>
            <use href="#bq-leaf" x="300" y="212" width="40" height="16"
                 transform="rotate(-6 320 220)"/>
          </g>

          <!-- Flowers framing the sides — pulled outward so the names
               themselves remain over the clearest area. -->
          <g class="nb-flowers">
            <use class="nb-bloom" href="#bq-marigold" x="22"  y="80"  width="68" height="68"/>
            <use class="nb-bloom" href="#bq-marigold" x="550" y="80"  width="68" height="68"/>
            <use class="nb-bloom" href="#bq-rose"     x="94"  y="150" width="46" height="46"/>
            <use class="nb-bloom" href="#bq-rose"     x="500" y="150" width="46" height="46"/>
            <use class="nb-bloom" href="#bq-bud"      x="150" y="68"  width="22" height="22"/>
            <use class="nb-bloom" href="#bq-bud"      x="468" y="68"  width="22" height="22"/>
            <use class="nb-bloom" href="#bq-bud"      x="298" y="196" width="20" height="20"/>
            <use class="nb-bloom" href="#bq-bud"      x="322" y="196" width="20" height="20"/>
          </g>
        </svg>

        <h2 class="hero-names">
          <span>{groom.firstName}</span>
          <span class="amp script">&amp;</span>
          <span>{bride.firstName}</span>
        </h2>
      </div>

      <div class="divider reveal"><Ornament type="flourish" /></div>
      <p class="welcome-message reveal">{wedding.welcomeMessage}</p>
    </div>
  </div>

  <!-- Bride & groom details -->
  <section class="couple" aria-labelledby="couple-heading">
    <div class="container">
      <h2 id="couple-heading" class="section-title reveal">The Couple</h2>
      <div class="divider reveal"><Ornament type="flourish" /></div>

      <div class="couple-grid">
        <article class="person glass-card reveal">
          <div class="person-sprig"><Ornament type="monogram-sprig" /></div>
          <p class="person-role">The Groom</p>
          <h3 class="person-name">{groom.fullName}</h3>
          <p class="person-parents">{groom.parents}</p>
          {groom.family && <p class="person-family">{groom.family}</p>}
        </article>

        <div class="couple-amp reveal" aria-hidden="true"><span class="script">&amp;</span></div>

        <article class="person glass-card reveal">
          <div class="person-sprig"><Ornament type="monogram-sprig" /></div>
          <p class="person-role">The Bride</p>
          <h3 class="person-name">{bride.fullName}</h3>
          <p class="person-parents">{bride.parents}</p>
          {bride.family && <p class="person-family">{bride.family}</p>}
        </article>
      </div>
    </div>
  </section>

  <!-- Wedding details card -->
  <section class="details" aria-labelledby="details-heading">
    <div class="container">
      <h2 id="details-heading" class="section-title reveal">Wedding Details</h2>
      <div class="divider reveal"><Ornament type="flourish" /></div>

      <dl class="details-card glass-card reveal">
        {details.map((d) => (
          <div class="detail-row">
            <dt>{d.label}</dt>
            <dd>{d.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <Venue />
  <InvitationCard />

  <footer class="invite-footer">
    <div class="divider"><Ornament type="leaf" /></div>
    <p class="script footer-names shimmer">{groom.firstName} &amp; {bride.firstName}</p>
    <p class="footer-note">We can't wait to celebrate with you.</p>
  </footer>
</section>

<style>
  .invitation {
    position: relative;
    animation: fade-up 1s ease both;
    overflow-x: clip; /* keep the right bouquet from causing horizontal scroll */

    /* ── Scoped palette: sampled from the bouquet SVG ─────────────────────
       Everything in the invitation inherits from these CSS variables, so a
       single block retones headings, body copy, labels, dividers and the
       ampersands to match the marigolds (#b56a1f base, #d99a4a petals) and
       the brass lamps (#b0894a mid, #8a6a2f deep). */
    --ink:         #a8541a; /* names + major headings — deep marigold */
    --ink-soft:    #6b4a26; /* body text — brass-dark, warm brown */
    --gold:        #b56a1f; /* primary marigold accent */
    --gold-deep:   #8a3e0c; /* deep terracotta — strongest accent (amp, script) */
    --gold-soft:   #d99a4a; /* bright marigold petal — hover/soft accents */
    --muted-gold:  #a8541a; /* labels, eyebrows */
    --gold-pale:   #e8d7b4; /* hairline dividers on silver bg */
    --gold-line:   #c6a86a; /* medium brass divider */
  }

  /* ── Top-corner flower bouquets with hanging lamps ────────────────────── */
  .bouquet {
    position: absolute;
    top: 0;
    width: clamp(110px, 32vw, 180px);
    height: auto;
    pointer-events: none;
    overflow: visible;
    z-index: 2;
  }
  .bouquet-left  { left: 0; }
  .bouquet-right {
    right: 0;
    /* Mirror the artwork horizontally so one SVG serves both sides. */
    transform: scaleX(-1);
    transform-origin: center;
  }

  /* Make room so the hanging lamps don't crash into the welcome text.
     Lamp bottom lands roughly at (bouquet-width × 1.14) px from the top of
     the invitation; this padding keeps a comfortable gap on every size. */
  .hero {
    padding: clamp(190px, 25vh, 240px) 0 40px;
    text-align: center;
  }

  /* ── Bouquet entrance animations ──────────────────────────────────────────
     The invitation section is `hidden` until the page-flip reveals it, so
     the animations only start playing once it becomes visible — no explicit
     JS trigger is needed. Timings are keyed off t=0 at that moment. */
  .bq-leaves use {
    opacity: 0;
    animation: fade 0.6s ease-out forwards;
  }
  .bq-leaves use:nth-child(1) { animation-delay: 0.15s; }
  .bq-leaves use:nth-child(2) { animation-delay: 0.22s; }
  .bq-leaves use:nth-child(3) { animation-delay: 0.29s; }
  .bq-leaves use:nth-child(4) { animation-delay: 0.36s; }

  .bq-bloom {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.2) rotate(-10deg);
    animation: bq-bloom 0.75s cubic-bezier(0.2, 0.9, 0.3, 1.4) forwards;
  }
  .bq-b1 { animation-delay: 0.25s; }
  .bq-b2 { animation-delay: 0.35s; }
  .bq-b3 { animation-delay: 0.45s; }
  .bq-b4 { animation-delay: 0.55s; }
  .bq-b5 { animation-delay: 0.65s; }
  .bq-b6 { animation-delay: 0.75s; }

  .bq-cord {
    stroke-dasharray: 80;
    stroke-dashoffset: 80;
    animation: bq-draw 0.55s cubic-bezier(0.3, 0.6, 0.3, 1) 0.85s forwards;
  }
  .bq-body {
    opacity: 0;
    transform-origin: 0 0;
    animation: bq-lamp-drop 0.7s cubic-bezier(0.2, 0.9, 0.35, 1.25) 0.95s forwards;
  }
  /* Gentle idle sway on the lamp pivot (not gyro-driven here — these corner
     lamps live inside a scrollable section, so CSS keyframes keep them
     cheap and reliable). */
  .bq-pivot {
    transform-origin: 0 0;
    animation: bq-sway 4.4s ease-in-out 1.8s infinite alternate;
  }
  .bouquet-right .bq-pivot {
    animation-duration: 4.0s;
    animation-delay: 1.95s;
  }
  .bq-halo {
    transform-box: fill-box;
    transform-origin: center;
    animation: bq-halo-pulse 2.6s ease-in-out 1.9s infinite alternate;
  }

  @keyframes fade { to { opacity: 1; } }
  @keyframes bq-bloom {
    0%   { opacity: 0; transform: scale(0.2) rotate(-10deg); }
    60%  { opacity: 1; transform: scale(1.08) rotate(2deg); }
    100% { opacity: 1; transform: scale(1) rotate(0); }
  }
  @keyframes bq-draw { to { stroke-dashoffset: 0; } }
  @keyframes bq-lamp-drop {
    0%   { opacity: 0; transform: translate(0, -50px) scale(0.85); }
    65%  { opacity: 1; transform: translate(0, 5px)   scale(1.03); }
    100% { opacity: 1; transform: translate(0, 0)    scale(1); }
  }
  @keyframes bq-sway {
    0%   { transform: rotate(-2.4deg); }
    100% { transform: rotate(2.4deg); }
  }
  @keyframes bq-halo-pulse {
    0%   { opacity: 0.75; transform: scale(1); }
    100% { opacity: 1;    transform: scale(1.08); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bq-leaves use { opacity: 1; animation: none; }
    .bq-bloom { opacity: 1; transform: none; animation: none; }
    .bq-cord { stroke-dashoffset: 0; animation: none; }
    .bq-body { opacity: 1; animation: none; }
    .bq-pivot { animation: none; }
    .bq-halo { animation: none; }
  }
  /* The names sit on a floral backdrop; the backdrop is positioned behind
     the h2 at low opacity so it reads as a decorative frame, not clutter. */
  .names-stage {
    position: relative;
    display: block;
    width: 100%;
    max-width: 720px;
    margin: 10px auto 0;
    padding: clamp(28px, 5vh, 48px) clamp(10px, 3vw, 24px);
  }
  .names-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
    /* Subtle so the names stay the hero. The slice preserveAspectRatio
       keeps the composition balanced even on narrow phones. */
    opacity: 0.55;
  }
  /* Fade the leaves and flowers in softly after the stage reveals. */
  .nb-leaves use {
    opacity: 0;
    animation: fade 0.9s ease-out forwards;
    animation-delay: 0.3s;
  }
  .nb-leaves use:nth-child(2) { animation-delay: 0.35s; }
  .nb-leaves use:nth-child(3) { animation-delay: 0.40s; }
  .nb-leaves use:nth-child(4) { animation-delay: 0.45s; }
  .nb-leaves use:nth-child(5) { animation-delay: 0.50s; }
  .nb-leaves use:nth-child(6) { animation-delay: 0.55s; }
  .nb-leaves use:nth-child(7) { animation-delay: 0.60s; }
  .nb-bloom {
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
    transform: scale(0.5);
    animation: nb-bloom-in 0.8s cubic-bezier(0.2, 0.9, 0.3, 1.3) forwards;
  }
  .nb-flowers use:nth-child(1) { animation-delay: 0.45s; }
  .nb-flowers use:nth-child(2) { animation-delay: 0.45s; }
  .nb-flowers use:nth-child(3) { animation-delay: 0.55s; }
  .nb-flowers use:nth-child(4) { animation-delay: 0.55s; }
  .nb-flowers use:nth-child(5) { animation-delay: 0.65s; }
  .nb-flowers use:nth-child(6) { animation-delay: 0.65s; }
  .nb-flowers use:nth-child(7) { animation-delay: 0.72s; }
  .nb-flowers use:nth-child(8) { animation-delay: 0.78s; }
  @keyframes nb-bloom-in {
    0%   { opacity: 0; transform: scale(0.4); }
    100% { opacity: 1; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) {
    .nb-leaves use, .nb-bloom { opacity: 1; transform: none; animation: none; }
  }

  .hero-names {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(10px, 4vw, 24px);
    font-size: clamp(2.4rem, 11vw, 4.2rem);
    flex-wrap: wrap;
    margin: 0;
    /* Deepened for contrast on the floral backdrop — a strong deep terracotta
       sampled from the marigold core (#b56a1f) darkened for text legibility. */
    color: #6e2a06;
    text-shadow: 0 1px 0 rgba(255, 249, 236, 0.6);
  }
  .hero-names .amp {
    font-size: clamp(2rem, 9vw, 3.4rem);
    /* Script accent reads as the brightest marigold — contrasts the names. */
    color: #b56a1f;
  }
  .welcome-message {
    max-width: 600px;
    margin: 0 auto;
    color: var(--ink-soft);
