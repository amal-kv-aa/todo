---
import { wedding } from '../data/wedding';
import { weddingDate, mapsDirectionsUrl } from '../data/format';
import AddToCalendar from './AddToCalendar.astro';
import InvitationCard from './InvitationCard.astro';
import Rsvp from './Rsvp.astro';

const { groom, bride } = wedding.couple;
const mapsUrl = mapsDirectionsUrl();
---

<section class="invitation custom-scrollbar" id="invitation" aria-label="Wedding invitation" hidden>
  <div class="inv-backbar">
    <button class="back-btn glass-pill" data-back-btn type="button" aria-label="Go back to cover page">
      ← Cover Page
    </button>
  </div>

  <div class="inv-container">
    <!-- Names header with ✦ divider -->
    <header class="inv-head glass-pane reveal">
      <div class="inv-sep">
        <span class="hr"></span>
        <span class="star">✦</span>
        <span class="hr"></span>
      </div>
      <div class="inv-names">
        <h1 class="inv-name">{groom.firstName}</h1>
        <div class="inv-amp-row" aria-hidden="true">
          <span class="hr-sm"></span>
          <span class="inv-amp">&amp;</span>
          <span class="hr-sm"></span>
        </div>
        <h1 class="inv-name">{bride.firstName}</h1>
      </div>
    </header>

    <!-- Groom & Bride card -->
    <article class="couple-card liquid-glass-gold card-inner-frame reveal">
      <div class="person">
        <p class="person-role">Groom</p>
        <h3 class="person-name">{groom.fullName}</h3>
        <p class="person-parents">{groom.parents}</p>
        {groom.family && <p class="person-family">{groom.family}</p>}
      </div>

      <div class="couple-divider" aria-hidden="true">
        <span class="hr-sm"></span>
        <svg viewBox="0 0 24 24" class="heart" fill="currentColor" aria-hidden="true">
          <path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/>
        </svg>
        <span class="hr-sm"></span>
      </div>

      <div class="person">
        <p class="person-role">Bride</p>
        <h3 class="person-name">{bride.fullName}</h3>
        <p class="person-parents">{bride.parents}</p>
        {bride.family && <p class="person-family">{bride.family}</p>}
      </div>
    </article>

    <!-- Mark Your Calendar -->
    <AddToCalendar />

    <!-- Wedding Celebrations -->
    <section class="celebrations reveal" aria-labelledby="celebrations-heading">
      <div class="cel-title glass-pane">
        <h3 id="celebrations-heading">Wedding Celebrations</h3>
        <p>Schedule and venue details for our ceremonies</p>
      </div>

      <article class="cel-card liquid-glass-gold">
        <div class="cel-top">
          <div class="cel-top-info">
            <span class="cel-badge">Wedding Ceremony</span>
            <h4 class="cel-venue">{wedding.venue.name}</h4>
            <p class="cel-addr">{wedding.venue.address}</p>
          </div>
          <div class="cel-pin" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"/>
              <circle cx="12" cy="10" r="3"/>
            </svg>
          </div>
        </div>

        <div class="cel-time">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/>
          </svg>
          <span>{weddingDate.time} · {weddingDate.weekday} {weddingDate.day} {weddingDate.monthShort} {weddingDate.year}</span>
        </div>

        <a class="btn-outline-gold cel-maps" href={mapsUrl} target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <polygon points="3 11 22 2 13 21 11 13 3 11"/>
          </svg>
          <span>Get Directions (Google Maps)</span>
        </a>
      </article>

      {wedding.extraDetails && wedding.extraDetails.length > 0 && (
        <article class="cel-card liquid-glass-gold cel-extras">
          <dl class="extras-list">
            {wedding.extraDetails.map((d) => (
              <div class="extra-row">
                <dt>{d.label}</dt>
                <dd>{d.value}</dd>
              </div>
            ))}
          </dl>
        </article>
      )}
    </section>

    <!-- Invitation Card -->
    <InvitationCard />

    <!-- RSVP (functionality preserved) -->
    <Rsvp />

    <!-- Footer -->
    <footer class="inv-foot glass-pane reveal">
      {wedding.footerQuote && (
        <p class="foot-quote">&ldquo;{wedding.footerQuote}&rdquo;</p>
      )}
      <div class="foot-sep">
        <span class="hr"></span>
        <span class="star">✦</span>
        <span class="hr"></span>
      </div>
      <p class="foot-title">Sharing the Happiness: Friends &amp; Relatives</p>
      {wedding.footerRegards && <p class="foot-note">{wedding.footerRegards}</p>}
    </footer>
  </div>
</section>

<style>
  .invitation {
    position: relative;
    min-height: 100dvh;
    padding: 56px 0 24px;
    animation: fade-up 0.9s ease both;
  }

  .inv-backbar {
    position: sticky;
    top: 0;
    z-index: 30;
    display: flex;
    justify-content: flex-start;
    padding: 12px 20px;
    pointer-events: none;
  }
  .back-btn {
    pointer-events: auto;
    appearance: none;
    cursor: pointer;
    padding: 6px 14px;
    border-radius: 999px;
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-caption);
    transition: color 0.2s ease, background 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .back-btn:hover { color: var(--ink); background: rgba(255, 255, 255, 0.95); }
  .back-btn:focus-visible {
    outline: 2px solid var(--gold);
    outline-offset: 2px;
  }

  .inv-container {
    width: 100%;
    max-width: 580px;
    margin: 0 auto;
    padding: 24px 20px 56px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Header */
  .inv-head {
    text-align: center;
    margin-bottom: 4px;
    padding: clamp(18px, 4vw, 26px) clamp(16px, 4vw, 22px);
  }
  .inv-sep {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .inv-sep .hr {
    height: 1px;
    width: 48px;
    background: rgba(60, 60, 60, 0.5);
  }
  .inv-sep .star { color: var(--gold); font-size: 14px; }
  .inv-names {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .inv-name {
    font-family: var(--font-script);
    font-weight: 400;
    font-size: clamp(56px, 15vw, 82px);
    line-height: 1.05;
    letter-spacing: 0;
    color: var(--gold);
    padding: 0.04em 0.08em;
  }
  .inv-amp-row {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .hr-sm { height: 1px; width: 32px; background: var(--gold-wash); display: inline-block; }
  .inv-amp {
    font-family: var(--font-script);
    font-style: normal;
    font-size: 2rem;
    color: var(--gold);
    line-height: 1;
  }

  /* Couple card */
  .couple-card {
    border-radius: 18px;
    padding: 22px;
    text-align: center;
  }
  .person-role {
    font-size: 12px;
    color: var(--gold);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin-bottom: 4px;
  }
  .person-name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.6rem, 6.5vw, 2rem);
    color: var(--ink);
    line-height: 1.15;
  }
  .person-parents {
    font-size: 0.95rem;
    color: var(--ink-soft);
    font-weight: 600;
    margin-top: 6px;
    line-height: 1.5;
  }
  .person-family {
    font-size: 0.9rem;
    color: var(--ink-mute);
    font-style: italic;
    margin-top: 4px;
    line-height: 1.5;
  }
  .couple-divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    margin: 16px 0;
  }
  .couple-divider .hr-sm { width: 56px; background: rgba(60, 60, 60, 0.3); }
  .heart {
    width: 12px;
    height: 12px;
    color: var(--gold);
  }

  /* Celebrations */
  .celebrations {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cel-title {
    text-align: center;
    margin-bottom: 2px;
    padding: 18px 20px;
  }
  .cel-title h3 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.45rem, 5.5vw, 1.7rem);
    color: var(--ink);
  }
  .cel-title p {
    font-size: 0.85rem;
    color: var(--ink-label);
    margin-top: 2px;
  }

  .cel-card {
    border-radius: 18px;
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .cel-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 12px;
  }
  .cel-top-info { flex: 1; min-width: 0; }
  .cel-badge {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    background: var(--gold);
    color: #FCFAF6;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 700;
    margin-bottom: 8px;
  }
  .cel-venue {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.25rem;
    color: var(--ink);
  }
  .cel-addr {
    font-size: 0.88rem;
    color: var(--ink-mute);
    margin-top: 2px;
    line-height: 1.5;
  }
  .cel-pin {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: var(--cream);
    border: 1px solid rgba(60, 60, 60, 0.3);
    display: grid;
    place-items: center;
    color: var(--gold);
    flex-shrink: 0;
  }
  .cel-pin svg { width: 20px; height: 20px; }
  .cel-time {
    display: flex;
    align-items: center;
    gap: 8px;
    padding-top: 12px;
    border-top: 1px solid rgba(60, 60, 60, 0.2);
    font-size: 0.88rem;
    color: var(--ink-soft);
    font-weight: 600;
  }
  .cel-time svg { width: 14px; height: 14px; color: var(--gold); flex-shrink: 0; }
  .cel-maps {
    width: 100%;
  }
  .cel-maps svg { width: 14px; height: 14px; color: var(--gold); }

  .cel-extras { padding: 18px 20px; }
  .extras-list {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .extra-row {
    display: grid;
    grid-template-columns: 110px 1fr;
    gap: 10px;
    align-items: baseline;
  }
  .extra-row dt {
    font-size: 12px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 700;
  }
  .extra-row dd {
    margin: 0;
    font-size: 1rem;
    color: var(--ink);
  }
  @media (max-width: 420px) {
    .extra-row { grid-template-columns: 90px 1fr; gap: 8px; }
  }

  /* Footer */
  .inv-foot {
    text-align: center;
    padding: 24px 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: 8px;
  }
  .foot-quote {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.02rem;
    color: var(--ink-label);
    line-height: 1.55;
  }
  .foot-sep {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .foot-sep .hr { height: 1px; width: 32px; background: rgba(60, 60, 60, 0.35); }
  .foot-sep .star { color: var(--gold); font-size: 13px; }
  .foot-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.04rem;
    color: var(--ink);
    letter-spacing: 0.02em;
  }
  .foot-note {
    font-size: 0.82rem;
    color: var(--ink-caption);
  }
</style>
