---
import { wedding } from '../data/wedding';
import { weddingDate } from '../data/format';
import Countdown from './Countdown.astro';

const { groom, bride } = wedding.couple;
---

<section class="welcome" id="welcome" aria-label="Wedding reception invitation">
  <div class="invite-page" data-enter role="button" tabindex="0" aria-label="Open the invitation">
    <div class="page-content">
      <p class="w-eyebrow">The Wedding Reception of</p>

      <div class="w-names">
        <span class="w-name">{bride.firstName}</span>
        <span class="w-amp">&amp;</span>
        <span class="w-name">{groom.firstName}</span>
      </div>

      <div class="w-rule" aria-hidden="true"><span></span>&#10022;<span></span></div>

      <p class="w-tagline">{wedding.tagline}</p>

      <p class="w-date">
        {weddingDate.weekday} &nbsp;·&nbsp; {weddingDate.day} {weddingDate.monthLong} {weddingDate.year}
      </p>
      <p class="w-when">{weddingDate.time}</p>

      <div class="w-count">
        <Countdown minimal />
      </div>

      <div class="w-enter">
        <span class="w-enter-label">Tap to open</span>
        <span class="w-enter-ico" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none">
            <path d="M8 5l8 7-8 7" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  .welcome {
    /* Scoped parchment palette — warm gold/brown to match the frame artwork. */
    --p-gold: #b0894a;
    --p-gold-deep: #8a6a2f;
    --p-ink: #6b5433;
    --p-script: #7c5c30;

    position: fixed;
    inset: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    background: var(--cream);
    /* Turn around the left edge like a page. */
    transform-origin: left center;
    backface-visibility: hidden;
    transition:
      transform 1.15s cubic-bezier(0.66, 0.02, 0.28, 1),
      box-shadow 1.15s ease;
    will-change: transform;
  }
  .welcome.is-flipping {
    transform: perspective(2200px) rotateY(-172deg);
    box-shadow: 40px 0 90px rgba(80, 55, 20, 0.3);
  }
  /* Shading that sweeps across the page as it turns, for depth. */
  .welcome::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(90deg, rgba(60, 40, 15, 0) 55%, rgba(60, 40, 15, 0.22) 100%);
    opacity: 0;
    transition: opacity 1.15s ease;
  }
  .welcome.is-flipping::after {
    opacity: 1;
  }

  .invite-page {
    position: relative;
    width: min(92vw, calc(92svh * 0.6787));
    aspect-ratio: 490 / 722;
    max-height: 94svh;
    background: #ede1d3; /* parchment colour taken from the frame artwork */
    border-radius: 14px;
    box-shadow: 0 24px 70px rgba(90, 65, 20, 0.28);
    cursor: pointer;
    overflow: hidden;
    animation: fade-up 1s ease both;
  }
  .invite-page:focus-visible {
    outline: 3px solid var(--p-gold);
    outline-offset: 4px;
  }

  .page-content {
    position: absolute;
    inset: 0;
    padding: 12% 11%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0;
  }

  .w-eyebrow {
    font-family: var(--font-body);
    font-size: clamp(0.6rem, 2.6vw, 0.78rem);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--p-ink);
    margin-bottom: clamp(8px, 2.5vh, 18px);
  }
  .w-names {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(2px, 1vh, 8px);
  }
  .w-name {
    font-family: var(--font-script);
    font-size: clamp(2.6rem, 13vw, 4.2rem);
    line-height: 1;
    color: var(--p-script);
  }
  .w-amp {
    font-family: var(--font-script);
    font-size: clamp(1.6rem, 7vw, 2.4rem);
    color: var(--p-gold);
    line-height: 1;
  }
  .w-rule {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    color: var(--p-gold);
    font-size: 0.8rem;
    margin: clamp(10px, 2.5vh, 18px) 0;
  }
  .w-rule span {
    height: 1px;
    width: clamp(36px, 12vw, 64px);
    background: linear-gradient(to right, transparent, var(--p-gold));
  }
  .w-rule span:last-child {
    background: linear-gradient(to left, transparent, var(--p-gold));
  }
  .w-tagline {
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(0.9rem, 3.6vw, 1.15rem);
    color: var(--p-ink);
    margin-bottom: clamp(10px, 2.2vh, 16px);
  }
  .w-date {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(0.95rem, 4vw, 1.3rem);
    color: var(--p-gold-deep);
    letter-spacing: 0.02em;
  }
  .w-when {
    font-family: var(--font-body);
    font-size: clamp(0.66rem, 2.8vw, 0.82rem);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--p-ink);
    margin-top: 4px;
  }
  .w-count {
    margin-top: clamp(14px, 3.5vh, 26px);
  }

  .w-enter {
    margin-top: clamp(16px, 4vh, 30px);
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--p-gold-deep);
    animation: soft-pulse 2.8s ease-in-out infinite;
  }
  .w-enter-label {
    font-family: var(--font-body);
    font-size: 0.72rem;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    font-weight: 600;
  }
  .w-enter-ico {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    border: 1.4px solid var(--p-gold);
    color: var(--p-gold-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .welcome {
      transition: opacity 0.5s ease;
    }
    .welcome.is-flipping {
      transform: none;
      opacity: 0;
    }
    .w-enter {
      animation: none;
    }
    .invite-page {
      animation: none;
    }
  }
</style>
