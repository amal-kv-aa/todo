---
import { wedding } from '../data/wedding';
import { weddingDate } from '../data/format';

const { groom, bride } = wedding.couple;

const startISO = wedding.dateISO;
const endISO =
  wedding.endISO
  || new Date(new Date(startISO).getTime() + 3 * 60 * 60 * 1000).toISOString();

const title = `${groom.firstName} & ${bride.firstName} — Wedding`;
const location = `${wedding.venue.name}, ${wedding.venue.address}`;
const description = wedding.invitationMessage;

const uid = (
  `${groom.firstName}-${bride.firstName}-${startISO.slice(0, 10)}`
    .toLowerCase()
    .replace(/[^a-z0-9-]/g, '')
) + '@wedding-card';

const event = { title, startISO, endISO, location, description, uid };
---

<article class="mark liquid-glass-gold reveal" aria-labelledby="mark-heading">
  <p class="mark-eyebrow">Mark Your Calendar</p>
  <h3 id="mark-heading" class="mark-date">
    {weddingDate.weekday}, {weddingDate.day} {weddingDate.monthLong} {weddingDate.year}
  </h3>
  <p class="mark-time">Ceremony at {weddingDate.time}</p>

  <div class="mark-actions">
    <a class="btn-dark" data-add-google href="#" target="_blank" rel="noopener" aria-label="Add to Google Calendar">
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M8 2v3"/><path d="M16 2v3"/><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18"/>
      </svg>
      <span>Add to Calendar</span>
    </a>
    <button type="button" class="ics-btn" data-add-ics aria-label="Download .ics file for Apple Calendar or Outlook">
      .ics
    </button>
  </div>

  <script type="application/json" data-calendar-event set:html={JSON.stringify(event)}></script>
</article>

<script>
  import { initAddToCalendar } from '../scripts/calendar';
  initAddToCalendar();
</script>

<style>
  .mark {
    border-radius: 18px;
    padding: 22px 20px;
    text-align: center;
  }
  .mark-eyebrow {
    font-size: 12px;
    color: var(--ink-label);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-weight: 600;
    margin-bottom: 4px;
  }
  .mark-date {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: clamp(1.45rem, 5.5vw, 1.7rem);
    color: var(--ink);
    line-height: 1.2;
  }
  .mark-time {
    font-size: 0.95rem;
    color: var(--ink-caption);
    font-weight: 600;
    margin-top: 2px;
  }
  .mark-actions {
    margin-top: 14px;
    display: inline-flex;
    gap: 8px;
    align-items: center;
    justify-content: center;
  }
  .mark-actions .btn-dark svg { color: var(--gold-pale); }
  .ics-btn {
    appearance: none;
    cursor: pointer;
    font-family: var(--font-body);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--ink-caption);
    background: transparent;
    border: 1px solid rgba(60, 60, 60, 0.4);
    padding: 9px 12px;
    border-radius: 999px;
    transition: background 0.2s ease, color 0.2s ease;
    -webkit-tap-highlight-color: transparent;
  }
  .ics-btn:hover { background: var(--cream); color: var(--ink); }
  .ics-btn:focus-visible { outline: 2px solid var(--gold); outline-offset: 2px; }
</style>
