---
import '../styles/global.css';
import { wedding } from '../data/wedding';

interface Props {
  title?: string;
  description?: string;
}
const { title = wedding.siteTitle, description = wedding.welcomeMessage } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFFFFF" />
    <!-- Lock to the light cream palette: tells browsers (incl. Chrome Android
         & iOS Safari) not to auto-invert or apply forced-dark heuristics. -->
    <meta name="color-scheme" content="light" />
    <meta name="supported-color-schemes" content="light" />

    <!-- Open Graph for pretty link previews when shared -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500&family=Cormorant+SC:wght@400;500;600;700&family=Great+Vibes&family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <!-- Dedicated fixed background layer. Keeps the frame-bg pinned behind
         everything — avoids iOS Safari's unreliable `background-attachment:
         fixed` so the inner invitation scrolls its content while the image
         stays put, just like the welcome cover. -->
    <div class="site-bg" aria-hidden="true"></div>

    <!-- App loader: holds the UI until frame-bg.png is decoded, so guests
         never see a flash of unstyled content while the painted backdrop
         is still downloading. Dismissed by the inline script below. -->
    <div class="app-loader" id="app-loader" aria-hidden="true">
      <div class="app-loader-ring"></div>
      <p class="app-loader-text">Preparing your invitation…</p>
    </div>

    <slot />

    <script is:inline>
      (() => {
        const loader = document.getElementById('app-loader');
        if (!loader) return;
        const hide = () => loader.classList.add('is-hidden');
        const img = new Image();
        img.decoding = 'async';
        img.src = '/bg/frame-bg.png';
        if (img.complete) { hide(); return; }
        img.addEventListener('load', hide, { once: true });
        img.addEventListener('error', hide, { once: true });
        // Safety: never hold the UI more than 4s even if the image stalls.
        setTimeout(hide, 4000);
      })();
    </script>
  </body>
</html>

<style>
  html,
  body {
    width: 100%;
  }
</style>
